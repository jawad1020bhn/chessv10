{
  "manifest_version": 3,
  "name": "Chess Hint Assistant",
  "short_name": "Chess Coach",
  "version": "13.1.0",
  "version_name": "13.1.0 (Maia-3 local policy hints)",
  "author": "jawad1020bhn",
  "minimum_chrome_version": "114",
  "description": "Chess analysis workspace with verified positions, objective cloud analysis, and optional local Maia-3 human move-policy hints.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "scripting",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*",
    "https://lichess.org/*",
    "https://lichess.org/api/*",
    "https://explorer.lichess.ovh/*",
    "https://tablebase.lichess.ovh/*",
    "https://chess-api.com/*"
  ],
  "optional_host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open Chess Hint Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' https://lichess.org https://explorer.lichess.ovh https://tablebase.lichess.ovh https://chess-api.com https://raw.githubusercontent.com;"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
